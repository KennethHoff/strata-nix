 SYSFS = "/sys"
 
 
+def _rocr_visible(gpus):
+    """The KFD GPU nodes ROCR_VISIBLE_DEVICES leaves the HIP runtime, in its order: indices into the full list, or
+    GPU-<hex> UUIDs matched against a node's unique_id. HIP numbers the cards after this filter."""
+    visible = os.environ.get("ROCR_VISIBLE_DEVICES", "").strip()
+    if not visible:
+        return gpus
+    out = []
+    for tok in (t.strip() for t in visible.split(",")):
+        if tok.upper().startswith("GPU-"):
+            out += [g for g in gpus if format(int(g.get("unique_id") or 0), "x") == tok[4:].lower()]
+        elif tok.isdigit() and int(tok) < len(gpus):
+            out.append(gpus[int(tok)])
+    return out
+
